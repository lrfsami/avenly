# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# --- Chiffrement ---
# Clé Fernet (générée à l'étape 3)
FERNET_KEY=

# --- API La Bonne Alternance ---
# Jeton à demander sur https://api.apprentissage.beta.gouv.fr
LBA_API_TOKEN=
LBA_API_BASE_URL=https://api.apprentissage.beta.gouv.fr/api

# --- API Recherche d'entreprises (publique, sans clé) ---
RECHERCHE_ENTREPRISES_BASE_URL=https://recherche-entreprises.api.gouv.fr

# --- Géocodage (API IGN Géoplateforme, publique, sans clé) ---
GEOCODING_BASE_URL=https://data.geopf.fr/geocodage

# --- Réseau ---
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
# Recherche d'entreprises et géocodage. La Bonne Alternance est fixé à 1 req/s (60/min).
RATE_LIMIT_PER_SECOND=5

# --- CV ---
MAX_CV_SIZE_MB=5

# --- LLM (Claude) ---
# Clé API à créer sur https://console.anthropic.com (différente de l'abonnement Pro)
ANTHROPIC_API_KEY=
LLM_PROFILE_MODEL=claude-haiku-5-5
LLM_EMAIL_MODEL=claude-sonnet-5-5
# Longueur visée du corps des emails, en mots
EMAIL_MAX_WORDS=150
# Garde-fous de dépense (en dollars, sur le mois en cours) : au-delà, Avenly refuse les appels
LLM_MONTHLY_BUDGET_USD=5
LLM_BUDGET_PER_CLIENT_USD=3

# --- Base de données ---
# Vide = SQLite dans data/avenly.db. Exemple PostgreSQL : postgresql+psycopg://user:motdepasse@localhost/avenly
DATABASE_URL=
# Durée (jours) pendant laquelle une recherche domaine + zone est resservie depuis la base (0 = désactivé)
SOURCING_CACHE_DAYS=30
# Candidatures Avenly maximum vers une même entreprise sur 30 jours, tous clients confondus
MAX_APPLICATIONS_PER_COMPANY=2
# Durée (jours) pendant laquelle l'enrichissement d'une entreprise (site, résumé, emails) est réutilisé
ENRICHMENT_CACHE_DAYS=90

# --- Signature des emails (facultatif : sinon demandée au lancement) ---
# Reste sur ta machine : jamais envoyée au LLM.
SIGNATURE_EMAIL=
SIGNATURE_PHONE=
SIGNATURE_LINKEDIN=

# --- Logs ---
LOG_LEVEL=INFO
