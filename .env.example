# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# --- Chiffrement ---
# Clé Fernet (générée à l'étape 3)
FERNET_KEY=

# --- API La Bonne Alternance ---
# Jeton à demander sur https://api.apprentissage.beta.gouv.fr
LBA_API_TOKEN=
LBA_API_BASE_URL=https://api.apprentissage.beta.gouv.fr/api

# --- API Recherche d'entreprises (publique, sans clé) ---
RECHERCHE_ENTREPRISES_BASE_URL=https://recherche-entreprises.api.gouv.fr

# --- Géocodage (API IGN Géoplateforme, publique, sans clé) ---
GEOCODING_BASE_URL=https://data.geopf.fr/geocodage

# --- Réseau ---
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
# Recherche d'entreprises et géocodage. La Bonne Alternance est fixé à 1 req/s (60/min).
RATE_LIMIT_PER_SECOND=5

# --- CV ---
MAX_CV_SIZE_MB=5

# --- Logs ---
LOG_LEVEL=INFO
